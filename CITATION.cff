    given-names: Mohammad
    affiliation: "Purdue University"
    email: mgalib@purdue.edu
keywords:
  - hydrology
  - watershed
  - MCP
  - agentic
  - CAMELS
  - FAIR
  - reproducibility
  - defensibility
  - uncertainty-quantification
  - streamflow
